@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@implements ISpawnMenuTab
@attribute [Icon( "⚡" )]
@attribute [Title( "#spawnmenu.tab.wiremod" )]
@attribute [Order( 50 )]

<root class="tab">
	<div class="left">
		<VerticalMenu Value="@(SelectedType?.TargetType)" class="menuinner">
			<Options>
				@foreach (var group in GetWireGroups())
				{
					<h2>@group.Key</h2>
					@foreach (var type in group.OrderBy(x => x.Title))
					{
						if (type.IsAbstract) continue;
						<MenuOption Text="@type.Title" Icon="@type.Icon" @onclick="@(() => SelectType(type))" Value="@type.TargetType"></MenuOption>
					}
				}
			</Options>
		</VerticalMenu>
	</div>

	<div class="body menuinner">
		@if ( SelectedType != null )
		{
			<ControlSheet PropertyFilter="@FilterProperties" Target="@GetSelectedInstance()"></ControlSheet>
		}
	</div>
</root>

@code
{
	TypeDescription SelectedType;

	IGrouping<string, TypeDescription>[] GetWireGroups()
	{
		return Game.TypeLibrary.GetTypes<WireComponent>()
			.Where( t => !t.IsAbstract )
			.GroupBy( x => x.Group )
			.OrderBy( x => x.Key )
			.ToArray();
	}

	void SelectType( TypeDescription type )
	{
		SelectedType = type;
	}

	object GetSelectedInstance()
	{
		return SelectedType?.TargetType;
	}

	static bool FilterProperties( SerializedProperty o )
	{
		if ( o.PropertyType is null ) return false;
		if ( o.PropertyType.IsAssignableTo( typeof( Delegate ) ) ) return false;
		if ( o.IsMethod ) return true;
		if ( !o.HasAttribute<PropertyAttribute>() ) return false;
		return true;
	}
}
